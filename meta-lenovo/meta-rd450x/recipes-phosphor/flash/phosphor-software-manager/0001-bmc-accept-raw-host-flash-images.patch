+/** @brief Accept a raw host flash image in place of a tarball.
+ *
+ *  An image that carries an Intel flash descriptor is stored in the
+ *  directory as "bios.rom" next to a generated MANIFEST with the Host
+ *  purpose, as if it had been uploaded as a tarball.
+ *
+ *  @return true if the image was a raw host flash image and was stored
+ */
+static bool storeRawHostImage(int fd, const fs::path& dir,
+                              const std::string& id)
+{
+    static constexpr std::array<uint8_t, 4> signature{0x5a, 0xa5, 0xf0, 0x0f};
+    std::array<uint8_t, 4> found{};
+    if (pread(fd, found.data(), found.size(), 0x10) !=
+            static_cast<ssize_t>(found.size()) ||
+        found != signature)
+    {
+        return false;
+    }
+
+    std::ofstream rom(dir / "bios.rom", std::ios::binary | std::ios::trunc);
+    std::array<char, 65536> buf{};
+    off_t offset = 0;
+    while (true)
+    {
+        auto len = pread(fd, buf.data(), buf.size(), offset);
+        if (len < 0)
+        {
+            return false;
+        }
+        if (len == 0)
+        {
+            break;
+        }
+        rom.write(buf.data(), len);
+        offset += len;
+    }
+    rom.close();
+    if (!rom)
+    {
+        return false;
+    }
+
+    std::ofstream manifest(dir / MANIFEST_FILE_NAME, std::ios::trunc);
+    manifest
+        << "purpose=xyz.openbmc_project.Software.Version.VersionPurpose.Host\n"
+        << "version=uploaded-" << id << "\n"
+        << "MachineName=" << Version::getBMCMachine(OS_RELEASE_FILE) << "\n";
+    manifest.close();
+    return static_cast<bool>(manifest);
+}
+
